# ==============================================================================
# Analyticx AI — Application Environment Configuration Template
# Copy this file to `backend/.env` and configure credentials for production.
# ==============================================================================

# Core Application Settings
APP_NAME=Analyticx AI
DATABASE_URL=sqlite:///./analyticx.db
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=200
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_BASE_URL=http://localhost:5173

# JWT Security
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Google Cloud Identity / OAuth 2.0 Configuration
# ------------------------------------------------------------------------------
# To create Google OAuth credentials:
# 1. Visit Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Configure OAuth Consent Screen (User Type: External)
# 3. Create Credentials -> OAuth client ID -> Application type: Web application
# 4. Authorized JavaScript origins:
#    - http://localhost:5173
#    - http://127.0.0.1:5173
# 5. Authorized redirect URIs:
#    - http://localhost:5173/login
#    - http://127.0.0.1:5173/login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/login

# ------------------------------------------------------------------------------
# Google Gmail SMTP Configuration (Real Email Verification & OTP)
# ------------------------------------------------------------------------------
# To set up Gmail SMTP delivery:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Go to "App Passwords": https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Analyticx AI" (generates a 16-character code like: abcd efgh ijkl mnop)
# 4. Fill in SMTP_USER and SMTP_PASS below with your Gmail and App Password:
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_sender_gmail@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM="Analyticx AI <your_sender_gmail@gmail.com>"

# OTP Security & Attempt Parameters
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
