# ====================================================================
# ANALYTICX AI — PRODUCTION & ENVIRONMENT CONFIGURATION
# Agentic Business Analytics and Decision Intelligence Platform
# ====================================================================

# Core Application Settings
APP_NAME="Analyticx AI"
ENVIRONMENT=production
API_V1_PREFIX=/api/v1

# Database Configuration (SQLite default with WAL mode or PostgreSQL)
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/analyticx_ai
DATABASE_URL=sqlite:///./analyticx.db

# File Storage & Upload Limits
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=250

# Security & CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:8080,http://127.0.0.1:5173
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REQUIRE_AUTH=false

# Open-Weight Local LLM Settings (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen3:4b-instruct
LLM_REQUEST_TIMEOUT_SECONDS=90.0
LLM_CONTEXT_TOKENS=8192
LLM_MAX_CONCURRENT_REQUESTS=2
LLM_KEEP_ALIVE=15m
LLM_ENABLE_THINKING=false

# Rate Limiting & Monitoring
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT=100/minute
LOG_LEVEL=INFO
